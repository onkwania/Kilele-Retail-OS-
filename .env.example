# Local production example. Never point preview mode at real business records.
PORT=3001
DATABASE_PATH=./data/production.sqlite
APP_ORIGIN=https://pos.example.co.ke
PUBLIC_HOST=pos.example.co.ke
NODE_ENV=production
PREVIEW_MODE=false
# Leave unset for direct access. Set only behind a restricted, trusted proxy.
# The supplied private Docker/Caddy deployment uses one trusted hop.
# TRUST_PROXY=1
# --- Storage engine -------------------------------------------------------------
# sqlite (default) uses the ledger file at DATABASE_PATH.
# postgres uses Supabase/PostgreSQL through DATABASE_URL. The Express modules are still being
# converted slice by slice, so postgres mode currently refuses to start rather than silently
# serving the SQLite ledger - see docs/POSTGRES_MIGRATION.md for the status and the order.
DATABASE_ENGINE=sqlite
# Server-only. Never expose it through a VITE_* variable or the browser bundle.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Supabase requires TLS: "require" accepts the managed certificate, "verify-full" also
# validates the chain and hostname.
# DATABASE_SSL=require
# Keep this below the platform connection limit, and leave room for the migration CLI.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_APPLICATION_NAME=kilele-retail-os
# Tests and staging only: pins a scratch schema, because one Supabase project has one database.
# DATABASE_SEARCH_PATH=public
# One-time bootstrap variables: provide privately, then unset/remove.
# BOOTSTRAP_NAME=Business Owner
# BOOTSTRAP_EMAIL=owner@example.co.ke
# BOOTSTRAP_PASSWORD=provide-a-unique-private-passphrase
# BUSINESS_NAME=Your Business
# Optional explicitly authorised catalogue extension:
# CATALOGUE_ACTOR_EMAIL=owner@example.co.ke
