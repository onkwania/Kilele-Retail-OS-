# Local production example. Never point preview mode at real business records.
PORT=3001
DATABASE_PATH=./data/production.sqlite
APP_ORIGIN=https://pos.example.co.ke
PUBLIC_HOST=pos.example.co.ke
NODE_ENV=production
PREVIEW_MODE=false
# Leave unset for direct access. Set only behind a restricted, trusted proxy.
# The supplied private Docker/Caddy deployment uses one trusted hop.
# TRUST_PROXY=1
# --- Storage engine -------------------------------------------------------------
# sqlite (default) uses the ledger file at DATABASE_PATH.
# postgres uses Supabase/PostgreSQL through DATABASE_URL. Slice 1 (health, connection, startup) is
# live: the server boots only after a real round trip, the migrations and the financial guard
# triggers are verified, and every route outside a converted slice answers 503 NOT_MIGRATED instead
# of serving the SQLite ledger. See docs/POSTGRES_MIGRATION.md for the status and the order.
DATABASE_ENGINE=sqlite
# Server-only. Never expose it through a VITE_* variable or the browser bundle.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Supabase requires TLS. disable | require | verify-ca | verify-full.
#   require      encrypts, accepts the managed certificate without local CA validation
#   verify-ca    validates the chain against the system CA bundle, not the hostname
#   verify-full  validates the chain and the hostname - use this whenever you can
# Any other value is a hard startup error: this build will not guess at a weaker mode.
# DATABASE_SSL=require
# Apply migrations from Git at boot. Defaults to true outside production, false in production
# (there the release command migrates, so a bad deploy cannot change the schema on its own).
# DATABASE_AUTO_MIGRATE=false
# Keep this below the platform connection limit, and leave room for the migration CLI.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_APPLICATION_NAME=kilele-retail-os
# Tests and staging only: pins a scratch schema, because one Supabase project has one database.
# DATABASE_SEARCH_PATH=public
# One-time bootstrap variables: provide privately, then unset/remove.
# BOOTSTRAP_NAME=Business Owner
# BOOTSTRAP_EMAIL=owner@example.co.ke
# BOOTSTRAP_PASSWORD=provide-a-unique-private-passphrase
# BUSINESS_NAME=Your Business
# Optional explicitly authorised catalogue extension:
# CATALOGUE_ACTOR_EMAIL=owner@example.co.ke
